{
  "name": "uneva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "theme": "powershell -ExecutionPolicy Bypass -File scripts/extract-brand.ps1",
    "images": "node scripts/optimize-images.mjs",
    "videos": "node scripts/optimize-videos.mjs",
    "assets": "node scripts/optimize-images.mjs && node scripts/optimize-videos.mjs",
    "predev": "powershell -ExecutionPolicy Bypass -File scripts/extract-brand.ps1 && node scripts/optimize-images.mjs && node scripts/optimize-videos.mjs",
    "prebuild": "powershell -ExecutionPolicy Bypass -File scripts/extract-brand.ps1 && node scripts/optimize-images.mjs && node scripts/optimize-videos.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
